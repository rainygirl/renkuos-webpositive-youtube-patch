+# On 32-bit x86 there are six usable GPRs, all taken by t0..t5. The two
+# registers the 32-bit LLInt keeps for the whole of a function --
+# metadataTable (csr0) and PB (csr1) -- live instead in the callee-save area
+# of the frame, at -8 and -4 from cfr, the slots ARMv7 uses to save them.
+# Every instruction that names one is rewritten here into instructions on
+# real registers:
+#   - a load whose address uses one borrows its own destination register:
+#     the slot is loaded into it first (this is the operand fetch,
+#     [PB, PC, 1], and so the hot path);
+#   - a compare or a two-operand ALU instruction reads the slot as its one
+#     memory operand;
+#   - anything else borrows a register it does not use, saved around the
+#     rewritten instruction with push/pop.
+X86_VIRTUAL_CSR_OFFSETS = { "csr0" => -8, "csr1" => -4 }
+X86_SCRATCH_CANDIDATES = ["t0", "t1", "t2", "t3", "t5"]
+
+def x86VirtualCSR?(node)
+    node.is_a? RegisterID and X86_VIRTUAL_CSR_OFFSETS.has_key? node.name
+end
+
+def x86CSRSlot(codeOrigin, csr)
+    Address.new(codeOrigin, RegisterID.forName(codeOrigin, "cfr"), Immediate.new(codeOrigin, X86_VIRTUAL_CSR_OFFSETS[csr.name]))
+end
+
+def x86RegistersIn(node, set)
+    if node.is_a? RegisterID
+        set << node.name
+    elsif node.is_a? Address
+        x86RegistersIn(node.base, set)
+    elsif node.is_a? BaseIndex
+        x86RegistersIn(node.base, set)
+        x86RegistersIn(node.index, set)
+    end
+    set
+end
+
+def x86ReplaceRegister(node, from, to)
+    if node.is_a? RegisterID
+        node.name == from ? to : node
+    elsif node.is_a? Address
+        Address.new(node.codeOrigin, x86ReplaceRegister(node.base, from, to), node.offset)
+    elsif node.is_a? BaseIndex
+        BaseIndex.new(node.codeOrigin, x86ReplaceRegister(node.base, from, to), x86ReplaceRegister(node.index, from, to), node.scale, node.offset)
+    else
+        node
+    end
+end
+
+# push moves esp; an esp-based address inside the wrapped instruction has to
+# account for it.
+def x86AdjustForPush(node, bytes)
+    if node.is_a? Address and node.base.is_a? RegisterID and node.base.name == "sp"
+        node.withOffset(bytes)
+    elsif node.is_a? BaseIndex and node.base.is_a? RegisterID and node.base.name == "sp"
+        node.withOffset(bytes)
+    else
+        node
+    end
+end
+
+X86_BRANCH_LIKE = /^(b|j)/
+
+def x86RewriteVirtualCSR(node, newList)
+    usedList = []
+    node.operands.each { |op| x86RegistersIn(op, usedList) }
+    used = Set.new(usedList)
+    csrNames = used.select { |name| X86_VIRTUAL_CSR_OFFSETS.has_key? name }
+    if csrNames.empty?
+        newList << node
+        return
+    end
+    raise "Instruction uses both PB and metadataTable at #{node.codeOriginString}" if csrNames.size > 1
+    csr = RegisterID.forName(node.codeOrigin, csrNames[0])
+    slot = x86CSRSlot(node.codeOrigin, csr)
+    origin = node.codeOrigin
+    ops = node.operands
+    last = ops[-1]
+    csrIsPlain = ops.map { |op| x86VirtualCSR?(op) }
+
+    case node.opcode
+    when "push", "pop"
+        newList << Instruction.new(origin, node.opcode, ops.map { |op| x86VirtualCSR?(op) ? slot : op })
+        return
+    when "move"
+        if x86VirtualCSR?(ops[0]) and ops[1].is_a? RegisterID and not x86VirtualCSR?(ops[1])
+            newList << Instruction.new(origin, "loadp", [slot, ops[1]])
+            return
+        end
+        if x86VirtualCSR?(ops[1]) and ops[0].is_a? RegisterID
+            newList << Instruction.new(origin, "storep", [ops[0], slot])
+            return
+        end
+    end
+
+    # A load into a real register: the destination is free until the load
+    # writes it, so it carries the slot's value.
+    if node.opcode =~ /^load/ and last.is_a? RegisterID and not x86VirtualCSR?(last) and ops.size == 2 and not x86VirtualCSR?(ops[0])
+        addressRegisters = x86RegistersIn(ops[0], Set.new)
+        unless addressRegisters.include? last.name
+            newList << Instruction.new(origin, "loadp", [slot, last])
+            newList << Instruction.new(origin, node.opcode, [x86ReplaceRegister(ops[0], csr.name, last), last], node.annotation)
+            return
+        end
+    end
+
+    # The slot as the one memory operand of a compare/branch or of a
+    # two-operand ALU instruction on a real register.
+    plainUses = csrIsPlain.count(true)
+    memoryOperands = ops.count { |op| op.is_a? Address or op.is_a? BaseIndex or op.is_a? AbsoluteAddress }
+    if plainUses == 1 and memoryOperands == 0 and usedList.count(csr.name) == 1
+        twoOperandALU = (["addp", "subp", "andp", "orp", "xorp", "addi", "subi"].include?(node.opcode) && ops.size == 2 && x86VirtualCSR?(ops[0]) && last.is_a?(RegisterID))
+        if (node.opcode =~ X86_BRANCH_LIKE) || twoOperandALU
+            newList << Instruction.new(origin, node.opcode, ops.map { |op| x86VirtualCSR?(op) ? slot : op }, node.annotation)
+            return
+        end
+    end
+
+    raise "Cannot rewrite #{node.opcode} using #{csr.name} at #{node.codeOriginString}" if node.opcode =~ X86_BRANCH_LIKE
+
+    # General case: borrow a register the instruction does not use.
+    scratchName = X86_SCRATCH_CANDIDATES.find { |name| not used.include? name }
+    raise "No scratch register for #{node.opcode} at #{node.codeOriginString}" unless scratchName
+    scratch = RegisterID.forName(origin, scratchName)
+    writesCSR = (x86VirtualCSR?(last) && !(node.opcode =~ /^store/))
+    newList << Instruction.new(origin, "push", [scratch])
+    newList << Instruction.new(origin, "loadp", [slot.withOffset(0), scratch])
+    rewritten = ops.map { |op| x86AdjustForPush(x86ReplaceRegister(op, csr.name, scratch), 4) }
+    newList << Instruction.new(origin, node.opcode, rewritten, node.annotation)
+    newList << Instruction.new(origin, "storep", [scratch, slot]) if writesCSR
+    newList << Instruction.new(origin, "pop", [scratch])
+end
