 # GPR conventions, to match the baseline JIT:
 #
+# On 32-bit x86 (restored for Haiku; upstream dropped it in 2024)
+# a0, a1, a2, a3 are only there for ease-of-use of offlineasm; they are not
+# actually considered as such by the ABI and arguments are pushed on the
+# stack. a0 and a1 are ecx and edx, as for fastcall.
+#
+# eax => t0, a2, r0
+# edx => t1, a1, r1
+# ecx => t2, a0
+# ebx => t3, a3     (callee-save)
+# esi => t4         (callee-save)
+# edi => t5         (callee-save)
+# ebp => cfr
+# esp => sp
+#
 # On x86-64 (windows and non-windows)
 #
 # rax => t0,     r0
