+// #pragma mark - tracks and queues
+
+MediaPlayerPrivateHaikuMSE::Track* MediaPlayerPrivateHaikuMSE::trackFor(TrackID trackID)
+{
+    auto found = m_tracks.find(trackID);
+    return found == m_tracks.end() ? nullptr : found->value.get();
+}
+
+MediaPlayerPrivateHaikuMSE::Track* MediaPlayerPrivateHaikuMSE::activeTrack(HaikuTrackConfig::Kind kind)
+{
+    if (kind == HaikuTrackConfig::Kind::Video)
+        return m_haveVideoTrack ? trackFor(m_videoTrackID) : nullptr;
+    return m_haveAudioTrack ? trackFor(m_audioTrackID) : nullptr;
+}
+
+void MediaPlayerPrivateHaikuMSE::setTrackConfig(TrackID trackID, Ref<HaikuTrackConfig>&& config)
+{
+    bool sizeChanged = false;
+    {
+        BAutolock locker(m_lock);
+        auto* track = trackFor(trackID);
+        if (!track) {
+            auto newTrack = std::make_unique<Track>();
+            newTrack->id = trackID;
+            newTrack->kind = config->kind;
+            track = newTrack.get();
+            m_tracks.set(trackID, WTFMove(newTrack));
+        }
+        if (config->kind == HaikuTrackConfig::Kind::Video) {
+            if (!m_haveVideoTrack) {
+                m_haveVideoTrack = true;
+                m_videoTrackID = trackID;
+            }
+            if (trackID == m_videoTrackID) {
+                sizeChanged = !m_videoConfig || m_videoConfig->width != config->width
+                    || m_videoConfig->height != config->height;
+                m_videoConfig = config.ptr();
+            }
+        } else if (!m_haveAudioTrack) {
+            m_haveAudioTrack = true;
+            m_audioTrackID = trackID;
+        }
+    }
+    if (sizeChanged) {
+        if (auto player = m_player.get())
+            player->sizeChanged();
+    }
+}
+
+void MediaPlayerPrivateHaikuMSE::flushTrack(TrackID trackID)
+{
+    BAutolock locker(m_lock);
+    auto* track = trackFor(trackID);
+    if (!track)
+        return;
+    // WebCore also flushes outside a seek -- a quality switch re-enqueues
+    // from the last sync frame. The clock must not jump back to the last
+    // seek position then, and the frames before the current time it
+    // decodes again are not late, only not wanted.
+    if (!m_seeking) {
+        double now = clockLocked();
+        m_clockBase = now;
+        m_clockStarted = m_playing ? system_time() : 0;
+        m_seekFloor = now;
+    }
+    track->queue.clear();
+    track->flushRequested = true;
+    if (track->kind == HaikuTrackConfig::Kind::Video) {
+        for (auto& frame : m_frames)
+            m_freeBitmaps.append(frame.bitmap);
+        m_frames.clear();
+    } else {
+        m_ringRead = m_ringFill = 0;
+        m_audioClock = false;
+    }
+}
+
+void MediaPlayerPrivateHaikuMSE::enqueueSample(Ref<HaikuMediaSample>&& sample, TrackID trackID)
+{
+    BAutolock locker(m_lock);
+    auto* track = trackFor(trackID);
+    if (!track) {
+        MSE_LOG("sample for unknown track %llu\n", (unsigned long long)trackID);
+        return;
+    }
+    if (track->queue.isEmpty())
+        MSE_LOG("enqueue: track %llu from %.3f\n", (unsigned long long)trackID, sample->presentationTime().toDouble());
+    track->queue.append(WTFMove(sample));
+    m_receivedData = true;
+}
+
+bool MediaPlayerPrivateHaikuMSE::isReadyForMoreSamples(TrackID trackID)
+{
+    BAutolock locker(m_lock);
+    auto* track = trackFor(trackID);
+    if (!track)
+        return false;
+    size_t high = track->kind == HaikuTrackConfig::Kind::Video ? kVideoQueueHigh : kAudioQueueHigh;
+    return track->queue.size() < high;
+}
+
+void MediaPlayerPrivateHaikuMSE::notifyWhenReadyForMoreSamples(TrackID trackID, SourceBufferPrivateHaiku& sourceBuffer)
+{
+    BAutolock locker(m_lock);
+    auto* track = trackFor(trackID);
+    if (!track)
+        return;
+    track->waitingSourceBuffer = sourceBuffer;
+    track->notifyRequested = true;
+    requestMoreSamplesIfNeeded(*track);
+}
+
+// With m_lock held.
+void MediaPlayerPrivateHaikuMSE::requestMoreSamplesIfNeeded(Track& track)
+{
+    size_t low = track.kind == HaikuTrackConfig::Kind::Video ? kVideoQueueLow : kAudioQueueLow;
+    if (!track.notifyRequested || track.queue.size() >= low)
+        return;
+    track.notifyRequested = false;
+    callOnMainThread([sourceBuffer = track.waitingSourceBuffer, trackID = track.id] {
+        if (RefPtr protectedSourceBuffer = sourceBuffer.get())
+            protectedSourceBuffer->readyForMoreSamples(trackID);
+    });
+}
+
+// #pragma mark - decoding thread
+
+void MediaPlayerPrivateHaikuMSE::startDecodeThread()
+{
+    if (m_shutDown)
+        return;
+    if (m_thread >= 0)
+        return;
+    m_weakThis = WeakPtr { *this };
+    m_quit = false;
+    m_thread = spawn_thread(decodeThreadEntry, "MSE decode", B_DISPLAY_PRIORITY, this);
+    if (m_thread >= 0)
+        resume_thread(m_thread);
+}
+
+void MediaPlayerPrivateHaikuMSE::stopDecodeThread()
+{
+    if (m_thread < 0)
+        return;
+    m_quit = true;
+    status_t result;
+    wait_for_thread(m_thread, &result);
+    m_thread = -1;
+}
+
+status_t MediaPlayerPrivateHaikuMSE::decodeThreadEntry(void* cookie)
+{
+    static_cast<MediaPlayerPrivateHaikuMSE*>(cookie)->decodeLoop();
+    return B_OK;
+}
+
+void MediaPlayerPrivateHaikuMSE::decodeLoop()
+{
+    bigtime_t nextStatus = system_time() + 2000000;
+    while (!m_quit) {
+        bool worked = decodeAudio();
+        worked = decodeVideo() || worked;
+        presentVideo();
+        if (mseDebug() && system_time() >= nextStatus) {
+            nextStatus = system_time() + 2000000;
+            BAutolock locker(m_lock);
+            auto* video = activeTrack(HaikuTrackConfig::Kind::Video);
+            auto* audio = activeTrack(HaikuTrackConfig::Kind::Audio);
+            MSE_LOG("status: clock %.3f %s, queues v%zu a%zu, ring %.2f s, frames %zu, shown %u dropped %u\n",
+                clockLocked(), m_playing ? "playing" : "paused",
+                video ? video->queue.size() : 0, audio ? audio->queue.size() : 0,
+                m_audioRate && m_audioChannels ? double(m_ringFill) / m_audioChannels / m_audioRate : 0.0,
+                m_frames.size(), m_totalFrames, m_droppedFrames);
+        }
+        if (!worked)
+            snooze(5000);
+    }
+}
+
+bool MediaPlayerPrivateHaikuMSE::ensureSoundPlayer(const media_raw_audio_format& format)
+{
+    BAutolock locker(m_lock);
+    if (m_soundPlayer && m_audioRate == uint32_t(format.frame_rate) && m_audioChannels == format.channel_count)
+        return true;
+
+    BSoundPlayer* old = m_soundPlayer;
+    m_soundPlayer = nullptr;
+    if (old) {
+        m_lock.Unlock();
+        deleteHTML5SoundPlayer(old);
+        m_lock.Lock();
+    }
+
+    m_audioRate = uint32_t(format.frame_rate);
+    m_audioChannels = format.channel_count;
+    m_ring.resize(size_t(m_audioRate) * m_audioChannels * 2);
+    m_ringRead = m_ringFill = 0;
+
+    media_raw_audio_format output = media_raw_audio_format::wildcard;
+    output.frame_rate = format.frame_rate;
+    output.channel_count = format.channel_count;
+    output.format = media_raw_audio_format::B_AUDIO_FLOAT;
+    output.byte_order = B_MEDIA_HOST_ENDIAN;
+
+    m_soundPlayer = new BSoundPlayer(&output, "HTML5 Audio (MSE)", soundCallback, nullptr, this);
+    if (m_soundPlayer->InitCheck() != B_OK) {
+        MSE_LOG("sound player failed: %s\n", strerror(m_soundPlayer->InitCheck()));
+        delete m_soundPlayer;
+        m_soundPlayer = nullptr;
+        return false;
+    }
+    registerHTML5SoundPlayer(m_soundPlayer);
+    m_soundPlayer->SetVolume(m_muted ? 0 : m_volume);
+    m_soundPlayer->SetHasData(true);
+    if (m_playing)
+        m_soundPlayer->Start();
+    MSE_LOG("sound player %u Hz x%u\n", m_audioRate, m_audioChannels);
+    return true;
+}
+
+void MediaPlayerPrivateHaikuMSE::soundCallback(void* cookie, void* buffer, size_t size, const media_raw_audio_format& format)
+{
+    auto* player = static_cast<MediaPlayerPrivateHaikuMSE*>(cookie);
+    float* out = static_cast<float*>(buffer);
+    size_t wanted = size / sizeof(float);
+    size_t copied = 0;
+
+    if (player->m_lock.Lock()) {
+        if (player->m_playing && player->m_audioClock && player->m_audioChannels) {
+            size_t capacity = player->m_ring.size();
+            size_t count = std::min(wanted, player->m_ringFill);
+            count -= count % player->m_audioChannels;
+            for (size_t i = 0; i < count; i++)
+                out[i] = player->m_ring[(player->m_ringRead + i) % capacity];
+            player->m_ringRead = (player->m_ringRead + count) % capacity;
+            player->m_ringFill -= count;
+            player->m_audioNextTime += double(count / player->m_audioChannels) / player->m_audioRate;
+            copied = count;
+        }
+        player->m_lock.Unlock();
+    }
+    if (copied < wanted)
+        memset(out + copied, 0, (wanted - copied) * sizeof(float));
+}
+
+bool MediaPlayerPrivateHaikuMSE::decodeAudio()
+{
+    RefPtr<HaikuTrackConfig> config;
+    TrackID trackID = 0;
+    bool reset = false;
+    {
+        BAutolock locker(m_lock);
+        auto* track = activeTrack(HaikuTrackConfig::Kind::Audio);
+        if (!track)
+            return false;
+        if (track->flushRequested) {
+            track->flushRequested = false;
+            reset = true;
+        }
+        if (track->queue.size() < 2)
+            config = nullptr;
+        else
+            config = track->queue.first()->protectedConfig().ptr();
+        trackID = track->id;
+        // Keep about half a second of sound decoded, no more.
+        if (m_audioRate && m_ringFill >= size_t(m_audioRate) * m_audioChannels / 2)
+            config = nullptr;
+    }
+    if (reset) {
+        delete m_audioDecoder;
+        m_audioDecoder = nullptr;
+    }
+    if (!config)
+        return false;
+
+    if (m_audioDecoder && !m_audioDecoder->config().sameDecoderSetup(*config)) {
+        delete m_audioDecoder;
+        m_audioDecoder = nullptr;
+    }
+    if (!m_audioDecoder) {
+        auto* decoder = new HaikuSampleDecoder(*this, trackID, config.releaseNonNull());
+        status_t status = decoder->initialize();
+        if (status != B_OK) {
+            MSE_LOG("no audio decoder: %s\n", strerror(status));
+            delete decoder;
+            BAutolock locker(m_lock);
+            if (auto* track = activeTrack(HaikuTrackConfig::Kind::Audio))
+                track->queue.clear();
+            return false;
+        }
+        m_audioDecoder = decoder;
+        if (!ensureSoundPlayer(decoder->output().u.raw_audio))
+            return false;
+    }
+
+    const media_raw_audio_format& format = m_audioDecoder->output().u.raw_audio;
+    size_t bytes = format.buffer_size ? format.buffer_size : 4096 * format.channel_count * sizeof(float);
+    Vector<uint8_t> buffer(bytes);
+    int64 frames = 0;
+    media_header header;
+    media_decode_info info;
+    if (m_audioDecoder->Decode(buffer.data(), &frames, &header, &info) != B_OK || frames <= 0)
+        return false;
+
+    BAutolock locker(m_lock);
+    if (!m_audioChannels || format.channel_count != m_audioChannels)
+        return true;
+    double start = header.start_time / 1000000.0;
+    if (start + double(frames) / m_audioRate < m_seekFloor)
+        return true; // before the seek target
+    size_t samples = size_t(frames) * m_audioChannels;
+    size_t capacity = m_ring.size();
+    if (samples > capacity - m_ringFill)
+        samples = capacity - m_ringFill;
+    if (!m_audioClock && !m_ringFill) {
+        m_audioNextTime = std::max(start, m_seekFloor);
+        m_audioClock = true;
+    }
+    size_t write = (m_ringRead + m_ringFill) % capacity;
+    if (format.format == media_raw_audio_format::B_AUDIO_FLOAT) {
+        const float* in = reinterpret_cast<const float*>(buffer.data());
+        for (size_t i = 0; i < samples; i++)
+            m_ring[(write + i) % capacity] = in[i];
+    } else if (format.format == media_raw_audio_format::B_AUDIO_SHORT) {
+        const int16* in = reinterpret_cast<const int16*>(buffer.data());
+        for (size_t i = 0; i < samples; i++)
+            m_ring[(write + i) % capacity] = in[i] / 32768.0f;
+    } else
+        return true;
+    m_ringFill += samples;
+    return true;
+}
+
+bool MediaPlayerPrivateHaikuMSE::decodeVideo()
+{
+    RefPtr<HaikuTrackConfig> config;
+    TrackID trackID = 0;
+    bool reset = false;
+    BBitmap* bitmap = nullptr;
+    {
+        BAutolock locker(m_lock);
+        auto* track = activeTrack(HaikuTrackConfig::Kind::Video);
+        if (!track)
+            return false;
+        if (track->flushRequested) {
+            track->flushRequested = false;
+            reset = true;
+        }
+        trackID = track->id;
+        if (m_frames.size() < kDecodedFramesAhead && track->queue.size() >= kVideoDecodeMinimum)
+            config = track->queue.first()->protectedConfig().ptr();
+        if (config && !m_freeBitmaps.isEmpty())
+            bitmap = m_freeBitmaps.takeLast();
+    }
+    if (reset) {
+        delete m_videoDecoder;
+        m_videoDecoder = nullptr;
+    }
+    if (!config) {
+        if (bitmap) {
+            BAutolock locker(m_lock);
+            m_freeBitmaps.append(bitmap);
+        }
+        return false;
+    }
+
+    if (m_videoDecoder && !m_videoDecoder->config().sameDecoderSetup(*config)) {
+        delete m_videoDecoder;
+        m_videoDecoder = nullptr;
+    }
+    if (!m_videoDecoder) {
+        auto* decoder = new HaikuSampleDecoder(*this, trackID, config.releaseNonNull());
+        status_t status = decoder->initialize();
+        if (status != B_OK) {
+            MSE_LOG("no video decoder: %s\n", strerror(status));
+            delete decoder;
+            BAutolock locker(m_lock);
+            if (auto* track = activeTrack(HaikuTrackConfig::Kind::Video))
+                track->queue.clear();
+            if (bitmap)
+                m_freeBitmaps.append(bitmap);
+            return false;
+        }
+        m_videoDecoder = decoder;
+    }
+
+    const media_raw_video_format& format = m_videoDecoder->output().u.raw_video;
+    BRect bounds(0, 0, format.display.line_width - 1, format.display.line_count - 1);
+    if (bitmap && bitmap->Bounds() != bounds) {
+        delete bitmap;
+        bitmap = nullptr;
+    }
+    if (!bitmap)
+        bitmap = new BBitmap(bounds, B_RGB32);
+
+    int64 count = 0;
+    media_header header;
+    media_decode_info info;
+    status_t status = m_videoDecoder->Decode(bitmap->Bits(), &count, &header, &info);
+
+    BAutolock locker(m_lock);
+    if (status != B_OK || header.start_time / 1000000.0 < m_seekFloor - 0.001) {
+        m_freeBitmaps.append(bitmap);
+        return status == B_OK;
+    }
+    DecodedFrame frame { header.start_time, bitmap };
+    size_t index = m_frames.size();
+    while (index && m_frames[index - 1].time > frame.time)
+        index--;
+    m_frames.insert(index, frame);
+    return true;
+}
+
+void MediaPlayerPrivateHaikuMSE::presentVideo()
+{
+    bool repaint = false;
+    bool first = false;
+    {
+        BAutolock locker(m_lock);
+        if (m_frames.isEmpty())
+            return;
+        size_t show = notFound;
+        if (m_showFirstFrame) {
+            show = 0;
+            first = true;
+            m_showFirstFrame = false;
+        } else if (m_playing) {
+            bigtime_t now = bigtime_t(clockLocked() * 1000000);
+            for (size_t i = 0; i < m_frames.size() && m_frames[i].time <= now; i++)
+                show = i;
+            if (show != notFound) {
+                m_totalFrames += show + 1;
+                m_droppedFrames += show; // decoded too late to be seen
+            }
+        }
+        if (show == notFound)
+            return;
+        for (size_t i = 0; i < show; i++)
+            m_freeBitmaps.append(m_frames[i].bitmap);
+        if (m_displayBitmap)
+            m_freeBitmaps.append(m_displayBitmap);
+        m_displayBitmap = m_frames[show].bitmap;
+        m_frames.remove(0, show + 1);
+        repaint = true;
+    }
+    if (!repaint)
+        return;
+    callOnMainThread([weakThis = m_weakThis, first] {
+        if (!weakThis)
+            return;
+        if (auto player = weakThis->m_player.get()) {
+            if (first)
+                player->firstVideoFrameAvailable();
+            player->repaint();
+        }
+    });
+}
+
+} // namespace WebCore
+
+#endif
