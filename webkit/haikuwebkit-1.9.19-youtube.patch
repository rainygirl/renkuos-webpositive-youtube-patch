+class HaikuSampleDecoder;
+
+// The Media Source Extensions engine. WebCore's SourceBuffer keeps the
+// buffered frames and hands them over in decode order through
+// enqueueSample(); a decoding thread runs them through the Media Kit
+// (BMediaDecoder -- the GMA500's H.264 add-on where there is one, the ffmpeg
+// plugin otherwise), keeps a little decoded audio ahead of a BSoundPlayer,
+// and shows each video frame when the audio clock reaches it.
+class MediaPlayerPrivateHaikuMSE final
+    : public MediaPlayerPrivateInterface
+    , public RefCounted<MediaPlayerPrivateHaikuMSE>
+    , public CanMakeWeakPtr<MediaPlayerPrivateHaikuMSE> {
+public:
+    void ref() const final { RefCounted::ref(); }
+    void deref() const final { RefCounted::deref(); }
+
+    explicit MediaPlayerPrivateHaikuMSE(MediaPlayer*);
+    ~MediaPlayerPrivateHaikuMSE();
+
+    static void registerMediaEngine(MediaEngineRegistrar);
+    static void getSupportedTypes(HashSet<String>&);
+    static MediaPlayer::SupportsType supportsType(const MediaEngineSupportParameters&);
+
+    constexpr MediaPlayerType mediaPlayerType() const final { return MediaPlayerType::HaikuMSE; }
+
+    // From MediaSourcePrivateHaiku, on the main thread.
+    void durationChanged();
+    void setReadyState(MediaPlayer::ReadyState);
+    void setNetworkState(MediaPlayer::NetworkState);
+    void notifyActiveSourceBuffersChanged();
+    void setTrackConfig(TrackID, Ref<HaikuTrackConfig>&&);
+    void flushTrack(TrackID);
+    void enqueueSample(Ref<HaikuMediaSample>&&, TrackID);
+    bool isReadyForMoreSamples(TrackID);
+    void notifyWhenReadyForMoreSamples(TrackID, SourceBufferPrivateHaiku&);
+
+    MediaPlayer::ReadyState readyState() const final { return m_readyState; }
+
+private:
+    friend class HaikuSampleDecoder;
+
+    void load(const String&) final;
+    void load(const URL&, const ContentType&, MediaSourcePrivateClient&) final;
+#if ENABLE(MEDIA_STREAM)
+    void load(MediaStreamPrivate&) final { }
+#endif
+    void cancelLoad() final;
+    void play() final;
+    void pause() final;
+    FloatSize naturalSize() const final;
+    bool hasVideo() const final;
+    bool hasAudio() const final;
+    void setPageIsVisible(bool) final { }
+    MediaTime currentTime() const final;
+    bool timeIsProgressing() const final;
+    void seekToTarget(const SeekTarget&) final;
+    bool seeking() const final { return !!m_lastSeekTarget; }
+    bool paused() const final { return !m_playing; }
+    void setVolume(float) final;
+    void setMuted(bool) final;
+    MediaPlayer::NetworkState networkState() const final { return m_networkState; }
+    MediaTime maxTimeSeekable() const final;
+    const PlatformTimeRanges& buffered() const final { return PlatformTimeRanges::emptyRanges(); }
+    bool didLoadingProgress() const final;
+    void paint(GraphicsContext&, const FloatRect&) final;
+    MediaTime duration() const final;
+    std::optional<VideoPlaybackQualityMetrics> videoPlaybackQualityMetrics() final;
+    DestinationColorSpace colorSpace() final;
+
+    struct Track {
+        TrackID id { 0 };
+        HaikuTrackConfig::Kind kind { HaikuTrackConfig::Kind::Video };
+        Deque<Ref<HaikuMediaSample>> queue;
+        ThreadSafeWeakPtr<SourceBufferPrivateHaiku> waitingSourceBuffer;
+        bool notifyRequested { false };
+        bool flushRequested { false };
+    };
+
+    struct DecodedFrame {
+        bigtime_t time { 0 };
+        BBitmap* bitmap { nullptr };
+    };
+
+    // Everything below is shared with the decoding and sound threads and is
+    // guarded by m_lock.
+    Track* trackFor(TrackID);
+    Track* activeTrack(HaikuTrackConfig::Kind);
+    double clockLocked() const;
+    void startDecodeThread();
+    void stopDecodeThread();
+    static status_t decodeThreadEntry(void*);
+    void decodeLoop();
+    bool decodeAudio();
+    bool decodeVideo();
+    void presentVideo();
+    void requestMoreSamplesIfNeeded(Track&);
+    bool ensureSoundPlayer(const media_raw_audio_format&);
+    static void soundCallback(void*, void*, size_t, const media_raw_audio_format&);
+
+    ThreadSafeWeakPtr<MediaPlayer> m_player;
+    RefPtr<MediaSourcePrivateHaiku> m_mediaSourcePrivate;
+    MediaPlayer::ReadyState m_readyState { MediaPlayer::ReadyState::HaveNothing };
+    MediaPlayer::NetworkState m_networkState { MediaPlayer::NetworkState::Empty };
+    std::optional<SeekTarget> m_lastSeekTarget;
+    mutable bool m_receivedData { false };
+
+    mutable BLocker m_lock { "MSE player" };
+    HashMap<TrackID, std::unique_ptr<Track>, WTF::IntHash<TrackID>, WTF::UnsignedWithZeroKeyHashTraits<TrackID>> m_tracks;
+    TrackID m_videoTrackID { 0 };
+    TrackID m_audioTrackID { 0 };
+    bool m_haveVideoTrack { false };
+    bool m_haveAudioTrack { false };
+    RefPtr<HaikuTrackConfig> m_videoConfig;
+
+    bool m_playing { false };
+    float m_volume { 1 };
+    bool m_muted { false };
+
+    // The clock. With audio it is the presentation time of the next audio
+    // frame the sound player will take; without, system time since play().
+    double m_clockBase { 0 };
+    bigtime_t m_clockStarted { 0 };
+    bool m_audioClock { false };
+    double m_audioNextTime { 0 };
+    // Frames and sound from before the last seek target are not shown.
+    double m_seekFloor { 0 };
+    bool m_seeking { false };
+
+    // Decoded audio, interleaved float.
+    Vector<float> m_ring;
+    size_t m_ringRead { 0 };
+    size_t m_ringFill { 0 };
+    uint32_t m_audioRate { 0 };
+    uint32_t m_audioChannels { 0 };
+
+    Vector<DecodedFrame> m_frames;
+    Vector<BBitmap*> m_freeBitmaps;
+    BBitmap* m_displayBitmap { nullptr };
+    bool m_showFirstFrame { true };
+    uint32_t m_totalFrames { 0 };
+    uint32_t m_droppedFrames { 0 };
+
+    WeakPtr<MediaPlayerPrivateHaikuMSE> m_weakThis; // made on the main thread, copied by others
+    thread_id m_thread { -1 };
+    volatile bool m_quit { false };
+    bool m_shutDown { false };
+
+    // Owned by the decoding thread.
+    HaikuSampleDecoder* m_videoDecoder { nullptr };
+    HaikuSampleDecoder* m_audioDecoder { nullptr };
+    BSoundPlayer* m_soundPlayer { nullptr };
+};
+
