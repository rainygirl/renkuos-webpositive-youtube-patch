+// Big-endian readers over a bounded range. Every read is checked against the
+// end; a short box makes the whole parse fail rather than read past it.
+class Reader {
+public:
+    Reader(const uint8_t* data, size_t size) : m_data(data), m_size(size) { }
+
+    bool has(size_t n) const { return m_offset + n <= m_size; }
+    size_t offset() const { return m_offset; }
+    size_t remaining() const { return m_size - m_offset; }
+    const uint8_t* current() const { return m_data + m_offset; }
+    void skip(size_t n) { m_offset = std::min(m_size, m_offset + n); }
+    void seek(size_t n) { m_offset = std::min(m_size, n); }
+
+    bool u8(uint8_t& v) { if (!has(1)) return false; v = m_data[m_offset++]; return true; }
+    bool u16(uint16_t& v)
+    {
+        if (!has(2)) return false;
+        v = (uint16_t(m_data[m_offset]) << 8) | m_data[m_offset + 1];
+        m_offset += 2;
+        return true;
+    }
+    bool u32(uint32_t& v)
+    {
+        if (!has(4)) return false;
+        v = (uint32_t(m_data[m_offset]) << 24) | (uint32_t(m_data[m_offset + 1]) << 16)
+            | (uint32_t(m_data[m_offset + 2]) << 8) | m_data[m_offset + 3];
+        m_offset += 4;
+        return true;
+    }
+    bool u64(uint64_t& v)
+    {
+        uint32_t hi, lo;
+        if (!u32(hi) || !u32(lo)) return false;
+        v = (uint64_t(hi) << 32) | lo;
+        return true;
+    }
+
+private:
+    const uint8_t* m_data;
+    size_t m_size;
+    size_t m_offset { 0 };
+};
+
+static uint32_t fourcc(const char* s)
+{
+    return (uint32_t(uint8_t(s[0])) << 24) | (uint32_t(uint8_t(s[1])) << 16)
+        | (uint32_t(uint8_t(s[2])) << 8) | uint8_t(s[3]);
+}
+
+static String fourccString(uint32_t type)
+{
+    char s[5] = { char(type >> 24), char(type >> 16), char(type >> 8), char(type), 0 };
+    return String::fromLatin1(s);
+}
+
+// Walks the child boxes of a container: calls the function with each child's
+// type and payload. Returns false on a malformed box.
+template<typename Function>
+static bool forEachBox(const uint8_t* data, size_t size, Function&& function)
+{
+    Reader reader(data, size);
+    while (reader.remaining() >= 8) {
+        size_t start = reader.offset();
+        uint32_t size32, type;
+        reader.u32(size32);
+        reader.u32(type);
+        uint64_t boxSize = size32;
+        size_t header = 8;
+        if (size32 == 1) {
+            if (!reader.u64(boxSize))
+                return false;
+            header = 16;
+        } else if (!size32)
+            boxSize = size - start;
+        if (boxSize < header || start + boxSize > size)
+            return false;
+        if (!function(type, data + start + header, size_t(boxSize - header)))
+            return false;
+        reader.seek(start + boxSize);
+    }
+    return true;
+}
+
+// The AudioSpecificConfig inside an esds box: ES_Descriptor (tag 3) ->
+// DecoderConfigDescriptor (tag 4) -> DecoderSpecificInfo (tag 5).
+static bool parseESDS(const uint8_t* data, size_t size, Vector<uint8_t>& out)
+{
+    Reader reader(data, size);
+    reader.skip(4); // version and flags
+    auto descriptor = [&](uint8_t& tag, size_t& length) {
+        if (!reader.u8(tag))
+            return false;
+        length = 0;
+        for (int i = 0; i < 4; i++) {
+            uint8_t byte;
+            if (!reader.u8(byte))
+                return false;
+            length = (length << 7) | (byte & 0x7f);
+            if (!(byte & 0x80))
+                break;
+        }
+        return true;
+    };
+    uint8_t tag;
+    size_t length;
+    if (!descriptor(tag, length) || tag != 3)
+        return false;
+    reader.skip(2); // ES_ID
+    uint8_t flags;
+    if (!reader.u8(flags))
+        return false;
+    if (flags & 0x80)
+        reader.skip(2);
+    if (flags & 0x40) {
+        uint8_t urlLength;
+        if (!reader.u8(urlLength))
+            return false;
+        reader.skip(urlLength);
+    }
+    if (flags & 0x20)
+        reader.skip(2);
+    if (!descriptor(tag, length) || tag != 4)
+        return false;
+    reader.skip(13); // objectTypeIndication .. avgBitrate
+    if (!descriptor(tag, length) || tag != 5 || !reader.has(length))
+        return false;
+    out.append(std::span<const uint8_t>(reader.current(), length));
+    return true;
+}
