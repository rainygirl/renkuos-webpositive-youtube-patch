+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Library General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ */
+
+#pragma once
+
+#if ENABLE(MEDIA_SOURCE)
+
+#include "FloatSize.h"
+#include "MediaSample.h"
+#include <wtf/MediaTime.h>
+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/Vector.h>
+#include <wtf/text/WTFString.h>
+
+namespace WebCore {
+
+// What a track's sample entry in the initialization segment says, as much
+// of it as a Media Kit decoder needs: the codec, its configuration record
+// (avcC for H.264, the AudioSpecificConfig for AAC) and the raw format.
+class HaikuTrackConfig final : public ThreadSafeRefCounted<HaikuTrackConfig> {
+public:
+    enum class Kind : uint8_t { Video, Audio };
+
+    static Ref<HaikuTrackConfig> create() { return adoptRef(*new HaikuTrackConfig); }
+
+    bool sameDecoderSetup(const HaikuTrackConfig& other) const
+    {
+        return kind == other.kind && codec == other.codec && width == other.width
+            && height == other.height && sampleRate == other.sampleRate
+            && channels == other.channels && codecPrivate == other.codecPrivate;
+    }
+
+    Kind kind { Kind::Video };
+    String codec; // the sample entry's four-character code: avc1, avc3, mp4a
+    uint32_t timescale { 1 };
+    uint32_t width { 0 };
+    uint32_t height { 0 };
+    uint32_t sampleRate { 0 };
+    uint32_t channels { 0 };
+    Vector<uint8_t> codecPrivate;
+
+private:
+    HaikuTrackConfig() = default;
+};
+
+// One coded frame out of an fMP4 fragment.
+class HaikuMediaSample final : public MediaSample {
+public:
+    static Ref<HaikuMediaSample> create(TrackID trackID, Ref<HaikuTrackConfig>&& config,
+        Vector<uint8_t>&& data, const MediaTime& presentationTime, const MediaTime& decodeTime,
+        const MediaTime& duration, bool isSync)
+    {
+        return adoptRef(*new HaikuMediaSample(trackID, WTFMove(config), WTFMove(data),
+            presentationTime, decodeTime, duration, isSync));
+    }
+
