+
+// Consumes every complete top-level box in m_input. A moof is only consumed
+// together with the mdat that follows it, since its sample offsets point
+// into that mdat.
+bool SourceBufferPrivateHaiku::parseBoxes()
+{
+    size_t position = 0;
+    auto boxAt = [&](size_t at, uint32_t& type, uint64_t& size, size_t& header) {
+        if (m_input.size() - at < 8)
+            return false;
+        Reader reader(m_input.data() + at, m_input.size() - at);
+        uint32_t size32;
+        reader.u32(size32);
+        reader.u32(type);
+        size = size32;
+        header = 8;
+        if (size32 == 1) {
+            if (!reader.u64(size))
+                return false;
+            header = 16;
+        }
+        return true;
+    };
+
+    bool ok = true;
+    while (true) {
+        uint32_t type;
+        uint64_t size;
+        size_t header;
+        if (!boxAt(position, type, size, header))
+            break;
+        if (size < header) {
+            ok = false;
+            break;
+        }
+        if (position + size > m_input.size())
+            break;
+
+        const uint8_t* payload = m_input.data() + position + header;
+        size_t payloadSize = size_t(size - header);
+
+        if (type == fourcc("moov")) {
+            if (!parseMovie(payload, payloadSize)) {
+                ok = false;
+                break;
+            }
+            position += size;
+        } else if (type == fourcc("moof")) {
+            size_t next = position + size;
+            uint32_t nextType;
+            uint64_t nextSize;
+            size_t nextHeader;
+            // Boxes between the moof and its mdat are rare but legal; wait
+            // for the mdat itself.
+            if (!boxAt(next, nextType, nextSize, nextHeader))
+                break;
+            if (nextType != fourcc("mdat")) {
+                MSE_LOG("moof followed by %s, skipped\n", fourccString(nextType).utf8().data());
+                position = next;
+                continue;
+            }
+            if (next + nextSize > m_input.size())
+                break;
+            if (!parseFragment(m_input.data() + position, size_t(size),
+                m_input.data() + next + nextHeader, size_t(nextSize - nextHeader),
+                size_t(size + nextHeader))) {
+                ok = false;
+                break;
+            }
+            position = next + nextSize;
+        } else {
+            // ftyp, styp, sidx, emsg, prft, free, a stray mdat: nothing here
+            // that playback needs.
+            position += size;
+        }
+    }
+
+    if (position)
+        m_input.remove(0, position);
+    return ok;
+}
+
+bool SourceBufferPrivateHaiku::parseMovie(const uint8_t* data, size_t size)
+{
+    InitializationSegment segment;
+    MediaTime duration = MediaTime::invalidTime();
+
+    bool ok = forEachBox(data, size, [&](uint32_t type, const uint8_t* payload, size_t payloadSize) {
+        if (type == fourcc("mvhd")) {
+            Reader reader(payload, payloadSize);
+            uint8_t version;
+            reader.u8(version);
+            reader.skip(3);
+            uint32_t timescale = 0;
+            uint64_t length = 0;
+            if (version == 1) {
+                reader.skip(16);
+                reader.u32(timescale);
+                reader.u64(length);
+            } else {
+                uint32_t length32 = 0;
+                reader.skip(8);
+                reader.u32(timescale);
+                reader.u32(length32);
+                length = length32;
+            }
+            // A live stream's movie says 0 or all ones: unknown.
+            if (timescale && length && length != 0xffffffff && length != 0xffffffffffffffffull)
+                duration = MediaTime(length, timescale);
+            return true;
+        }
+        if (type == fourcc("trak")) {
+            uint32_t mp4TrackID = 0;
+            auto config = HaikuTrackConfig::create();
+            if (!parseTrack(payload, payloadSize, mp4TrackID, config))
+                return true; // a track we cannot play is left out, not fatal
+            TrackID id = trackIDFor(mp4TrackID);
+            MSE_LOG("track %u: %s, %ux%u, %u Hz x%u, %zu bytes of codec config\n", mp4TrackID,
+                config->codec.utf8().data(), config->width, config->height, config->sampleRate,
+                config->channels, config->codecPrivate.size());
+            if (config->kind == HaikuTrackConfig::Kind::Video) {
+                InitializationSegment::VideoTrackInformation info;
+                info.track = HaikuVideoTrackPrivate::create(id);
+                info.description = HaikuMediaDescription::create(config);
+                segment.videoTracks.append(WTFMove(info));
+            } else {
+                InitializationSegment::AudioTrackInformation info;
+                info.track = HaikuAudioTrackPrivate::create(id);
+                info.description = HaikuMediaDescription::create(config);
+                segment.audioTracks.append(WTFMove(info));
+            }
+            m_tracks.set(mp4TrackID, WTFMove(config));
+            return true;
+        }
+        if (type == fourcc("mvex")) {
+            return forEachBox(payload, payloadSize, [&](uint32_t childType, const uint8_t* child, size_t childSize) {
+                if (childType != fourcc("trex"))
+                    return true;
+                Reader reader(child, childSize);
+                reader.skip(4);
+                uint32_t trackID, descriptionIndex;
+                TrackDefaults defaults;
+                if (!reader.u32(trackID) || !reader.u32(descriptionIndex) || !reader.u32(defaults.duration)
+                    || !reader.u32(defaults.size) || !reader.u32(defaults.flags))
+                    return false;
+                m_trackDefaults.set(trackID, defaults);
+                return true;
+            });
+        }
+        return true;
+    });
+    if (!ok)
+        return false;
+
+    segment.duration = duration.isValid() ? duration : MediaTime::positiveInfiniteTime();
+    if (RefPtr mediaSource = mediaSourcePrivate()) {
+        for (auto& entry : m_tracks)
+            mediaSource->setTrackConfig(trackIDFor(entry.key), entry.value.copyRef());
+    }
+    didReceiveInitializationSegment(WTFMove(segment));
+    return true;
+}
+
+bool SourceBufferPrivateHaiku::parseTrack(const uint8_t* data, size_t size, uint32_t& trackID, Ref<HaikuTrackConfig>& config)
+{
+    bool haveHandler = false;
+    bool supported = false;
+
+    auto parseSampleEntry = [&](uint32_t type, const uint8_t* entry, size_t entrySize) {
+        Reader reader(entry, entrySize);
+        if (type == fourcc("avc1") || type == fourcc("avc3")) {
+            config->kind = HaikuTrackConfig::Kind::Video;
+            config->codec = fourccString(type);
+            reader.skip(24);
+            uint16_t width, height;
+            if (!reader.u16(width) || !reader.u16(height))
+                return false;
+            config->width = width;
+            config->height = height;
+            reader.seek(78);
+            return forEachBox(reader.current(), reader.remaining(), [&](uint32_t childType, const uint8_t* child, size_t childSize) {
+                if (childType == fourcc("avcC")) {
+                    config->codecPrivate.append(std::span<const uint8_t>(child, childSize));
+                    supported = true;
+                }
+                return true;
+            });
+        }
+        if (type == fourcc("mp4a")) {
+            config->kind = HaikuTrackConfig::Kind::Audio;
+            config->codec = "mp4a"_s;
+            reader.skip(16);
+            uint16_t channels, sampleSize;
+            uint32_t rate;
+            if (!reader.u16(channels) || !reader.u16(sampleSize))
+                return false;
+            reader.skip(4);
+            if (!reader.u32(rate))
+                return false;
+            config->channels = channels;
+            config->sampleRate = rate >> 16;
+            return forEachBox(reader.current(), reader.remaining(), [&](uint32_t childType, const uint8_t* child, size_t childSize) {
+                if (childType == fourcc("esds") && parseESDS(child, childSize, config->codecPrivate))
+                    supported = true;
+                return true;
+            });
+        }
+        MSE_LOG("sample entry %s is not supported\n", fourccString(type).utf8().data());
+        return true;
+    };
+
+    std::function<bool(uint32_t, const uint8_t*, size_t)> walk;
+    walk = [&](uint32_t type, const uint8_t* payload, size_t payloadSize) -> bool {
+        if (type == fourcc("tkhd")) {
+            Reader reader(payload, payloadSize);
+            uint8_t version;
+            reader.u8(version);
+            reader.skip(3 + (version == 1 ? 16 : 8));
+            return reader.u32(trackID);
+        }
+        if (type == fourcc("mdhd")) {
+            Reader reader(payload, payloadSize);
+            uint8_t version;
+            reader.u8(version);
+            reader.skip(3 + (version == 1 ? 16 : 8));
+            return reader.u32(config->timescale) && config->timescale;
+        }
+        if (type == fourcc("hdlr")) {
+            Reader reader(payload, payloadSize);
+            reader.skip(8);
+            uint32_t handler;
+            if (!reader.u32(handler))
+                return false;
+            haveHandler = handler == fourcc("vide") || handler == fourcc("soun");
+            return true;
+        }
+        if (type == fourcc("stsd")) {
+            Reader reader(payload, payloadSize);
+            reader.skip(8); // version, flags, entry count; the first entry is used
+            return forEachBox(reader.current(), reader.remaining(), [&](uint32_t entryType, const uint8_t* entry, size_t entrySize) {
+                return parseSampleEntry(entryType, entry, entrySize);
+            });
+        }
+        if (type == fourcc("mdia") || type == fourcc("minf") || type == fourcc("stbl"))
+            return forEachBox(payload, payloadSize, walk);
+        return true;
+    };
+
+    if (!forEachBox(data, size, walk))
+        return false;
+    return haveHandler && supported && trackID;
+}
+
+bool SourceBufferPrivateHaiku::parseFragment(const uint8_t* moof, size_t moofSize, const uint8_t* mdat,
+    size_t mdatSize, size_t mdatOffsetFromMoof)
+{
+    // Offsets in a trun are relative to the start of the moof box (YouTube
+    // and every other fMP4 muxer set default-base-is-moof), which here is
+    // `moof` itself; the payload of the following mdat begins
+    // `mdatOffsetFromMoof` bytes in.
+    Reader moofReader(moof, moofSize);
+    uint32_t size32, type;
+    moofReader.u32(size32);
+    moofReader.u32(type);
+    size_t moofHeader = size32 == 1 ? 16 : 8;
+
+    Vector<Ref<MediaSample>> samples;
+
+    bool ok = forEachBox(moof + moofHeader, moofSize - moofHeader, [&](uint32_t boxType, const uint8_t* traf, size_t trafSize) {
+        if (boxType != fourcc("traf"))
+            return true;
+
+        uint32_t trackID = 0;
+        uint32_t tfhdFlags = 0;
+        uint64_t baseOffset = 0;
+        TrackDefaults defaults;
+        uint64_t baseDecodeTime = 0;
+        bool haveTfdt = false;
+        size_t nextDataOffset = 0;
+        bool haveNextDataOffset = false;
+
+        return forEachBox(traf, trafSize, [&](uint32_t childType, const uint8_t* child, size_t childSize) {
+            Reader reader(child, childSize);
+            if (childType == fourcc("tfhd")) {
+                reader.u32(tfhdFlags);
+                tfhdFlags &= 0xffffff;
+                if (!reader.u32(trackID))
+                    return false;
+                auto found = m_trackDefaults.find(trackID);
+                if (found != m_trackDefaults.end())
+                    defaults = found->value;
+                if (tfhdFlags & 0x1 && !reader.u64(baseOffset))
+                    return false;
+                if (tfhdFlags & 0x2)
+                    reader.skip(4);
+                if (tfhdFlags & 0x8 && !reader.u32(defaults.duration))
+                    return false;
+                if (tfhdFlags & 0x10 && !reader.u32(defaults.size))
+                    return false;
+                if (tfhdFlags & 0x20 && !reader.u32(defaults.flags))
+                    return false;
+                return true;
+            }
+            if (childType == fourcc("tfdt")) {
+                uint8_t version;
+                reader.u8(version);
+                reader.skip(3);
+                if (version == 1)
+                    haveTfdt = reader.u64(baseDecodeTime);
+                else {
+                    uint32_t time;
+                    haveTfdt = reader.u32(time);
+                    baseDecodeTime = time;
+                }
+                return haveTfdt;
+            }
+            if (childType != fourcc("trun"))
+                return true;
+
+            auto config = m_tracks.find(trackID);
+            if (config == m_tracks.end())
+                return true; // a track the init segment left out
+
+            uint8_t version;
+            uint32_t flags;
+            reader.u32(flags);
+            version = flags >> 24;
+            flags &= 0xffffff;
+            uint32_t count;
+            if (!reader.u32(count))
+                return false;
+            int32_t dataOffset = 0;
+            if (flags & 0x1) {
+                uint32_t value;
+                if (!reader.u32(value))
+                    return false;
+                dataOffset = int32_t(value);
+            }
+            uint32_t firstFlags = defaults.flags;
+            bool haveFirstFlags = flags & 0x4;
+            if (haveFirstFlags && !reader.u32(firstFlags))
+                return false;
+
+            // Where this run's data starts, as an offset into the moof.
+            size_t position;
+            if (flags & 0x1)
+                position = size_t(int64_t(baseOffset) + dataOffset);
+            else if (haveNextDataOffset)
+                position = nextDataOffset;
+            else
+                position = mdatOffsetFromMoof;
+
+            uint32_t timescale = config->value->timescale;
+            for (uint32_t i = 0; i < count; i++) {
+                uint32_t duration = defaults.duration, sampleSize = defaults.size;
+                uint32_t sampleFlags = (i == 0 && haveFirstFlags) ? firstFlags : defaults.flags;
+                int64_t compositionOffset = 0;
+                if (flags & 0x100 && !reader.u32(duration))
+                    return false;
+                if (flags & 0x200 && !reader.u32(sampleSize))
+                    return false;
+                if (flags & 0x400 && !reader.u32(sampleFlags))
+                    return false;
+                if (flags & 0x800) {
+                    uint32_t value;
+                    if (!reader.u32(value))
+                        return false;
+                    compositionOffset = version ? int64_t(int32_t(value)) : int64_t(value);
+                }
+
+                if (position < mdatOffsetFromMoof || position - mdatOffsetFromMoof + sampleSize > mdatSize) {
+                    MSE_LOG("sample outside its mdat, fragment dropped\n");
+                    return false;
+                }
+                const uint8_t* bytes = mdat + (position - mdatOffsetFromMoof);
+                position += sampleSize;
+
+                bool isSync = config->value->kind == HaikuTrackConfig::Kind::Audio
+                    || !(sampleFlags & 0x10000);
+                MediaTime decodeTime(int64_t(baseDecodeTime), timescale);
+                MediaTime presentationTime(int64_t(baseDecodeTime) + compositionOffset, timescale);
+                baseDecodeTime += duration;
+
+                Vector<uint8_t> sampleData;
+                sampleData.append(std::span<const uint8_t>(bytes, sampleSize));
+                samples.append(HaikuMediaSample::create(trackIDFor(trackID), config->value.copyRef(),
+                    WTFMove(sampleData),
+                    presentationTime, decodeTime, MediaTime(duration, timescale), isSync));
+            }
+            nextDataOffset = position;
+            haveNextDataOffset = true;
+            return true;
+        });
+    });
+    if (!ok)
+        return false;
+
+    if (!samples.isEmpty()) {
+        MSE_LOG("fragment: %zu samples, track %llu, %.3f..%.3f\n", samples.size(),
+            (unsigned long long)(samples.first()->trackID() & 0xffffffff),
+            samples.first()->presentationTime().toDouble(), samples.last()->presentationTime().toDouble());
+    } else
+        MSE_LOG("fragment without samples\n");
+    for (auto& sample : samples)
+        didReceiveSample(WTFMove(sample));
+    return true;
+}
+
+void SourceBufferPrivateHaiku::reenqueueMediaIfNeeded(const MediaTime& currentTime)
+{
+    uint64_t before = m_enqueued;
+    SourceBufferPrivate::reenqueueMediaIfNeeded(currentTime);
+    MSE_LOG("buffer %u: reenqueue at %.3f enqueued %llu\n", m_index, currentTime.toDouble(),
+        (unsigned long long)(m_enqueued - before));
+}
+
+void SourceBufferPrivateHaiku::flush(TrackID trackID)
+{
+    MSE_LOG("buffer %u: flush\n", m_index);
+    if (RefPtr mediaSource = mediaSourcePrivate())
+        mediaSource->flushTrack(trackID);
+}
+
+void SourceBufferPrivateHaiku::enqueueSample(Ref<MediaSample>&& sample, TrackID trackID)
+{
+    m_enqueued++;
+    if (RefPtr mediaSource = mediaSourcePrivate())
+        mediaSource->enqueueSample(static_reference_cast<HaikuMediaSample>(WTFMove(sample)), trackID);
+}
+
+bool SourceBufferPrivateHaiku::isReadyForMoreSamples(TrackID trackID)
+{
+    RefPtr mediaSource = mediaSourcePrivate();
+    return mediaSource && mediaSource->isReadyForMoreSamples(trackID);
+}
+
+void SourceBufferPrivateHaiku::notifyClientWhenReadyForMoreSamples(TrackID trackID)
+{
+    if (RefPtr mediaSource = mediaSourcePrivate())
+        mediaSource->notifyWhenReadyForMoreSamples(trackID, *this);
+}
+
+void SourceBufferPrivateHaiku::readyForMoreSamples(TrackID trackID)
+{
+    uint64_t before = m_enqueued;
+    provideMediaData(trackID);
+    MSE_LOG("buffer %u: more samples wanted, enqueued %llu\n", m_index, (unsigned long long)(m_enqueued - before));
+}
+
+} // namespace WebCore
+
+#endif
