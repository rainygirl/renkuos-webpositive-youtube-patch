+        if (parameters.type.codecs().isEmpty())
+            return MediaPlayer::SupportsType::MayBeSupported;
+        // Answer for each codec, not just the container. YouTube asks about
+        // codecs that do not exist (av99) and about AV1 to see whether the
+        // answers mean anything; a browser that says yes to everything is
+        // told it cannot play the video at all. H.264 is the one video codec
+        // this hardware plays (the GMA500 decodes it); VP9 and AV1 in
+        // software are too slow on it, so they are not offered.
+        for (auto& codec : parameters.type.codecs()) {
+            String c = codec.convertToASCIILowercase();
+            if (!(c.startsWith("avc1"_s) || c.startsWith("avc3"_s)
+                || c.startsWith("mp4a"_s) || c == "mp3"_s || c == "opus"_s
+                || c == "vorbis"_s || c == "flac"_s || c == "vp8"_s
+                || c.startsWith("vp8."_s)))
+                return MediaPlayer::SupportsType::IsNotSupported;
+        }
+        return MediaPlayer::SupportsType::IsSupported;
     }
 
