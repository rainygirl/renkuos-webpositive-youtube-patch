diff -ruN orig/haikuwebkit/Source/WebCore/platform/graphics/haiku/HLSMediaIOHaiku.cpp haikuwebkit/Source/WebCore/platform/graphics/haiku/HLSMediaIOHaiku.cpp
--- orig/haikuwebkit/Source/WebCore/platform/graphics/haiku/HLSMediaIOHaiku.cpp
+++ haikuwebkit/Source/WebCore/platform/graphics/haiku/HLSMediaIOHaiku.cpp
@@ -0,0 +1,407 @@
+/*
