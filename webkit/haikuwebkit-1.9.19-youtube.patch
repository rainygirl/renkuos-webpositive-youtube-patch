+MediaPlayerPrivateHaikuMSE::MediaPlayerPrivateHaikuMSE(MediaPlayer* player)
+    : m_player(player)
+{
+    // A page is not torn down before the application exits, so the decoding
+    // thread would still be running, and using the sound player and the
+    // Media Kit, while they are destroyed.
+    registerHTML5MediaExitHandler(this, [](void* owner) {
+        auto* player = static_cast<MediaPlayerPrivateHaikuMSE*>(owner);
+        player->m_shutDown = true;
+        player->stopDecodeThread();
+        deleteHTML5SoundPlayer(player->m_soundPlayer);
+        player->m_soundPlayer = nullptr;
+    });
+}
+
+MediaPlayerPrivateHaikuMSE::~MediaPlayerPrivateHaikuMSE()
+{
+    unregisterHTML5MediaExitHandler(this);
+    stopDecodeThread();
+    deleteHTML5SoundPlayer(m_soundPlayer);
+    m_soundPlayer = nullptr;
+    delete m_videoDecoder;
+    delete m_audioDecoder;
+    for (auto& frame : m_frames)
+        delete frame.bitmap;
+    for (auto* bitmap : m_freeBitmaps)
+        delete bitmap;
+    delete m_displayBitmap;
+}
