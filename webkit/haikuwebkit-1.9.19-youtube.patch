+// Sound players still running when the process exits. WebPositive quits
+// without destroying its pages, so a playing <video> keeps its BSoundPlayer
+// while libmedia tears itself down, and the player's node thread then asks
+// for a buffer from a buffer list that is gone: a crash on every quit during
+// playback. They are stopped from an atexit handler, which runs before the
+// libraries' own teardown.
+static BLocker& soundPlayersLock()
+{
+    static BLocker lock("HTML5 sound players");
+    return lock;
+}
+
+static std::set<BSoundPlayer*>& soundPlayers()
+{
+    static std::set<BSoundPlayer*>* players = new std::set<BSoundPlayer*>;
+    return *players;
+}
+
+static std::map<void*, void (*)(void*)>& mediaExitHandlers()
+{
+    static std::map<void*, void (*)(void*)>* handlers = new std::map<void*, void (*)(void*)>;
+    return *handlers;
+}
+
+void shutdownHTML5Media()
+{
+    // The handlers join threads that may themselves take the lock, so they
+    // run without it.
+    std::map<void*, void (*)(void*)> handlers;
+    {
+        BAutolock locker(soundPlayersLock());
+        handlers = mediaExitHandlers();
+        mediaExitHandlers().clear();
+    }
+    if (mediaDebug())
+        fprintf(stderr, "[media] shutdown: stopping %zu media threads\n", handlers.size());
+    for (auto& [owner, handler] : handlers)
+        handler(owner);
+
+    BAutolock locker(soundPlayersLock());
+    if (mediaDebug())
+        fprintf(stderr, "[media] shutdown: deleting %zu sound players\n", soundPlayers().size());
+    // Deleted, not only stopped: a stopped BSoundPlayer still has a node with
+    // a control thread, and that thread faults once the Media Kit's own
+    // teardown has run after us. Media Source players are not destroyed
+    // before exit at all, so theirs always did.
+    for (BSoundPlayer* player : soundPlayers()) {
+        player->Stop(true, false);
+        delete player;
+    }
+    soundPlayers().clear();
+}
+
+static void stopSoundPlayersAtExit()
+{
+    shutdownHTML5Media();
+}
+
+// Called with soundPlayersLock() held.
+static void installSoundPlayersExitHandler()
+{
+    static bool registered = false;
+    if (!registered) {
+        atexit(stopSoundPlayersAtExit);
+        registered = true;
+    }
+}
+
+void registerHTML5SoundPlayer(BSoundPlayer* player)
+{
+    BAutolock locker(soundPlayersLock());
+    installSoundPlayersExitHandler();
+    soundPlayers().insert(player);
+}
+
+void registerHTML5MediaExitHandler(void* owner, void (*handler)(void*))
+{
+    BAutolock locker(soundPlayersLock());
+    installSoundPlayersExitHandler();
+    mediaExitHandlers()[owner] = handler;
+}
+
+void unregisterHTML5MediaExitHandler(void* owner)
+{
+    BAutolock locker(soundPlayersLock());
+    mediaExitHandlers().erase(owner);
+}
+
+void deleteHTML5SoundPlayer(BSoundPlayer* player)
+{
+    if (!player)
+        return;
+    {
+        BAutolock locker(soundPlayersLock());
+        // Already deleted by shutdownHTML5Media().
+        if (!soundPlayers().erase(player))
+            return;
+    }
+    delete player;
+}
