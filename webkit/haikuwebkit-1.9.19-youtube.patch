+void MediaPlayerPrivateHaikuMSE::play()
+{
+    {
+        BAutolock locker(m_lock);
+        if (m_playing)
+            return;
+        m_playing = true;
+        m_clockStarted = system_time();
+        if (m_soundPlayer)
+            m_soundPlayer->Start();
+    }
+    MSE_LOG("play at %.3f\n", currentTime().toDouble());
+}
+
+void MediaPlayerPrivateHaikuMSE::pause()
+{
+    BAutolock locker(m_lock);
+    if (!m_playing)
+        return;
+    MSE_LOG("pause at %.3f\n", clockLocked());
+    m_clockBase = clockLocked();
+    m_playing = false;
+    m_clockStarted = 0;
+    if (m_soundPlayer)
+        m_soundPlayer->Stop(false);
+}
+
+double MediaPlayerPrivateHaikuMSE::clockLocked() const
+{
+    if (m_haveAudioTrack) {
+        // The audio decides. Until its first frame is decoded the clock
+        // stands at the seek position.
+        return m_audioClock ? m_audioNextTime : m_clockBase;
+    }
+    if (m_playing && m_clockStarted)
+        return m_clockBase + (system_time() - m_clockStarted) / 1000000.0;
+    return m_clockBase;
+}
+
+MediaTime MediaPlayerPrivateHaikuMSE::currentTime() const
+{
+    if (m_lastSeekTarget)
+        return m_lastSeekTarget->time;
+    BAutolock locker(m_lock);
+    return MediaTime::createWithDouble(clockLocked());
+}
+
+bool MediaPlayerPrivateHaikuMSE::timeIsProgressing() const
+{
+    BAutolock locker(m_lock);
+    return m_playing && (!m_haveAudioTrack || (m_audioClock && m_ringFill));
+}
+
+void MediaPlayerPrivateHaikuMSE::seekToTarget(const SeekTarget& target)
+{
+    MSE_LOG("seek to %.3f\n", target.time.toDouble());
+    m_lastSeekTarget = target;
+    {
+        BAutolock locker(m_lock);
+        m_seekFloor = target.time.toDouble();
+        m_seeking = true;
+    }
+    m_mediaSourcePrivate->waitForTarget(target)->whenSettled(RunLoop::current(), [this, weakThis = WeakPtr { *this }](auto&& result) {
+        if (!weakThis)
+            return;
+        if (!result) {
+            MSE_LOG("seek: waitForTarget failed\n");
+            return;
+        }
+        MediaTime seekTime = *result;
+        MSE_LOG("seek: target buffered, seeking to %.3f\n", seekTime.toDouble());
+        m_mediaSourcePrivate->seekToTime(seekTime)->whenSettled(RunLoop::current(), [this, weakThis, seekTime] {
+            if (!weakThis)
+                return;
+            {
+                BAutolock locker(m_lock);
+                m_clockBase = seekTime.toDouble();
+                m_seekFloor = m_clockBase;
+                m_clockStarted = m_playing ? system_time() : 0;
+                m_audioClock = false;
+                m_ringRead = m_ringFill = 0;
+                m_showFirstFrame = true;
+                m_seeking = false;
+            }
+            m_lastSeekTarget.reset();
+            MSE_LOG("seeked to %.3f\n", seekTime.toDouble());
+            if (auto player = m_player.get()) {
+                player->seeked(seekTime);
+                player->timeChanged();
+            }
+        });
+    });
+}
