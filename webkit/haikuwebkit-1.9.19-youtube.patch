+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Library General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ */
+
+#include "config.h"
+#include "HLSMediaIOHaiku.h"
+
+#if ENABLE(VIDEO)
+
+#include <curl/curl.h>
+#include <MediaDefs.h>
+#include <Url.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <vector>
+
+namespace WebCore {
+
+static bool hlsDebug()
+{
+    static const bool debug = getenv("WEBKIT_MEDIA_DEBUG") != nullptr;
+    return debug;
+}
+
+#define HLS_LOG(...) do { if (hlsDebug()) fprintf(stderr, "[HLS] " __VA_ARGS__); } while (0)
+
+// How long a read may wait for the next segment before the reader is told
+// the stream ended. A live segment is a few seconds; a stall longer than this
+// is a dead stream.
+static const bigtime_t kReadTimeout = 30000000;
+
+// Data the reader has passed is dropped once this much has accumulated, so a
+// live stream that plays for hours does not grow the buffer for hours.
+static const off_t kKeepBehind = 2 * 1024 * 1024;
+static const off_t kFlushEvery = 8 * 1024 * 1024;
+
+HLSMediaIO::HLSMediaIO(const char* url, const char* userAgent)
+    : BAdapterIO(B_MEDIA_STREAMING | B_MEDIA_MUTABLE_SIZE, kReadTimeout)
+    , m_url(url)
+    , m_userAgent(userAgent)
+{
+}
+
+HLSMediaIO::~HLSMediaIO()
+{
+    m_quit = true;
+    if (m_thread >= 0) {
+        status_t result;
+        wait_for_thread(m_thread, &result);
+    }
+}
+
+bool HLSMediaIO::IsHLSURL(const char* url)
+{
+    if (!url)
+        return false;
+    // Strip the query: a playlist URL ends in .m3u8 before it, and YouTube's
+    // manifest URLs carry the format in the path instead.
+    const char* query = strchr(url, '?');
+    size_t length = query ? (size_t)(query - url) : strlen(url);
+    if (length >= 5 && !strncasecmp(url + length - 5, ".m3u8", 5))
+        return true;
+    if (strstr(url, "/api/manifest/hls_variant/") || strstr(url, "/api/manifest/hls_playlist/"))
+        return true;
+    return false;
+}
+
+status_t HLSMediaIO::Open()
+{
+    m_input = BuildInputAdapter();
+    m_running = true;
+    m_thread = spawn_thread(FetchThread, "HLS fetch", B_NORMAL_PRIORITY, this);
+    if (m_thread < 0)
+        return m_thread;
+    resume_thread(m_thread);
+    return BAdapterIO::Open();
+}
+
+bool HLSMediaIO::IsRunning() const
+{
+    return m_running;
+}
+
+status_t HLSMediaIO::SeekRequested(off_t)
+{
+    // A live stream cannot go back further than what is buffered.
+    return B_NOT_SUPPORTED;
+}
+
+status_t HLSMediaIO::FetchThread(void* cookie)
+{
+    static_cast<HLSMediaIO*>(cookie)->Fetch();
+    return B_OK;
+}
+
+namespace {
+
+struct TextSink {
+    BString* out;
+    volatile bool* quit;
+};
+
+size_t writeText(char* data, size_t size, size_t count, void* cookie)
+{
+    TextSink* sink = static_cast<TextSink*>(cookie);
+    if (*sink->quit)
+        return 0;
+    sink->out->Append(data, size * count);
+    return size * count;
+}
+
+struct SegmentSink {
+    BInputAdapter* input;
+    volatile bool* quit;
+    off_t* written;
+};
+
+size_t writeSegment(char* data, size_t size, size_t count, void* cookie)
+{
+    SegmentSink* sink = static_cast<SegmentSink*>(cookie);
+    if (*sink->quit)
+        return 0;
+    ssize_t result = sink->input->Write(data, size * count);
+    if (result < 0)
+        return 0;
+    *sink->written += result;
+    return size * count;
+}
+
+int abortIfQuit(void* cookie, curl_off_t, curl_off_t, curl_off_t, curl_off_t)
+{
+    return *static_cast<volatile bool*>(cookie) ? 1 : 0;
+}
+
+BString resolve(const BString& base, const BString& reference)
+{
+    if (reference.FindFirst("://") >= 0)
+        return reference;
+    BUrl url(BUrl(base.String(), true), reference);
+    return url.UrlString();
+}
+
+// The value of NAME= in an #EXT-X-... attribute list, or "" if absent.
+BString attribute(const BString& line, const char* name)
+{
+    BString key(name);
+    key << "=";
+    int32 start = line.FindFirst(key);
+    while (start > 0 && line[start - 1] != ':' && line[start - 1] != ',')
+        start = line.FindFirst(key, start + 1);
+    if (start < 0)
+        return BString();
+    start += key.Length();
+    BString value;
+    if (line[start] == '"') {
+        int32 end = line.FindFirst('"', start + 1);
+        line.CopyInto(value, start + 1, (end < 0 ? line.Length() : end) - start - 1);
+    } else {
+        int32 end = line.FindFirst(',', start);
+        line.CopyInto(value, start, (end < 0 ? line.Length() : end) - start);
+    }
+    return value;
+}
+
+void configure(CURL* curl, const BString& url, const BString& userAgent, volatile bool* quit)
+{
+    curl_easy_setopt(curl, CURLOPT_URL, url.String());
+    curl_easy_setopt(curl, CURLOPT_USERAGENT, userAgent.String());
+    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
+    curl_easy_setopt(curl, CURLOPT_FAILONERROR, 1L);
+    curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
+    curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 15L);
+    curl_easy_setopt(curl, CURLOPT_LOW_SPEED_LIMIT, 1024L);
+    curl_easy_setopt(curl, CURLOPT_LOW_SPEED_TIME, 20L);
+    curl_easy_setopt(curl, CURLOPT_NOPROGRESS, 0L);
+    curl_easy_setopt(curl, CURLOPT_XFERINFOFUNCTION, abortIfQuit);
+    curl_easy_setopt(curl, CURLOPT_XFERINFODATA, (void*)quit);
+}
+
+} // namespace
+
+bool HLSMediaIO::FetchText(const BString& url, BString& out)
+{
+    if (!m_playlistCurl)
+        m_playlistCurl = curl_easy_init();
+    CURL* curl = static_cast<CURL*>(m_playlistCurl);
+    if (!curl)
+        return false;
+    out.Truncate(0);
+    TextSink sink { &out, &m_quit };
+    configure(curl, url, m_userAgent, &m_quit);
+    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, writeText);
+    curl_easy_setopt(curl, CURLOPT_WRITEDATA, &sink);
+    CURLcode code = curl_easy_perform(curl);
+    long status = 0;
+    curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status);
+    if (code != CURLE_OK)
+        HLS_LOG("playlist failed: %s (HTTP %ld)\n", curl_easy_strerror(code), status);
+    return code == CURLE_OK;
+}
+
+bool HLSMediaIO::FetchSegment(const BString& url)
+{
+    if (!m_segmentCurl)
+        m_segmentCurl = curl_easy_init();
+    CURL* curl = static_cast<CURL*>(m_segmentCurl);
+    if (!curl)
+        return false;
+    SegmentSink sink { m_input, &m_quit, &m_written };
+    configure(curl, url, m_userAgent, &m_quit);
+    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, writeSegment);
+    curl_easy_setopt(curl, CURLOPT_WRITEDATA, &sink);
+    bigtime_t start = system_time();
+    off_t before = m_written;
+    CURLcode code = curl_easy_perform(curl);
+    long status = 0;
+    curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status);
+    if (code != CURLE_OK)
+        HLS_LOG("segment failed: %s (HTTP %ld)\n", curl_easy_strerror(code), status);
+    else {
+        HLS_LOG("segment %lld bytes in %.2f s\n", (long long)(m_written - before),
+            (system_time() - start) / 1e6);
+    }
+    return code == CURLE_OK;
+}
+
+// The variant to play: the tallest at or below WEBPOSITIVE_HLS_MAX_HEIGHT
+// (360 by default -- what a 1.33 GHz Atom draws comfortably), else the
+// smallest there is.
+BString HLSMediaIO::ChooseVariant(const BString& master, const BString& masterURL)
+{
+    int maxHeight = 360;
+    if (const char* env = getenv("WEBPOSITIVE_HLS_MAX_HEIGHT"))
+        maxHeight = atoi(env) > 0 ? atoi(env) : maxHeight;
+
+    BString best, smallest;
+    int bestHeight = -1, smallestHeight = 1 << 30;
+    long bestBandwidth = -1;
+
+    BString line, pendingInfo;
+    int32 position = 0;
+    while (position < master.Length()) {
+        int32 end = master.FindFirst('\n', position);
+        if (end < 0)
+            end = master.Length();
+        master.CopyInto(line, position, end - position);
+        line.RemoveAll("\r");
+        position = end + 1;
+
+        if (line.StartsWith("#EXT-X-STREAM-INF:")) {
+            pendingInfo = line;
+            continue;
+        }
+        if (line.IsEmpty() || line[0] == '#' || pendingInfo.IsEmpty())
+            continue;
+
+        BString resolution = attribute(pendingInfo, "RESOLUTION");
+        int height = 0;
+        int32 x = resolution.FindFirst('x');
+        if (x >= 0)
+            height = atoi(resolution.String() + x + 1);
+        long bandwidth = atol(attribute(pendingInfo, "BANDWIDTH").String());
+        BString uri = resolve(masterURL, line);
+        pendingInfo.Truncate(0);
+
+        if (height < smallestHeight) {
+            smallestHeight = height;
+            smallest = uri;
+        }
+        if (height <= maxHeight && (height > bestHeight
+            || (height == bestHeight && bandwidth > bestBandwidth))) {
+            bestHeight = height;
+            bestBandwidth = bandwidth;
+            best = uri;
+        }
+    }
+    if (best.IsEmpty()) {
+        HLS_LOG("no variant at or below %dp, taking %dp\n", maxHeight, smallestHeight);
+        return smallest;
+    }
+    HLS_LOG("variant %dp, %ld bit/s\n", bestHeight, bestBandwidth);
+    return best;
+}
+
+void HLSMediaIO::Fetch()
+{
+    FetchStream();
+    if (m_playlistCurl)
+        curl_easy_cleanup(static_cast<CURL*>(m_playlistCurl));
+    if (m_segmentCurl)
+        curl_easy_cleanup(static_cast<CURL*>(m_segmentCurl));
+    m_playlistCurl = m_segmentCurl = nullptr;
+    m_running = false;
+}
+
+void HLSMediaIO::FetchStream()
+{
+    BString playlist;
+    if (!FetchText(m_url, playlist)) {
+        m_running = false;
+        return;
+    }
+
+    BString mediaURL = m_url;
+    if (playlist.FindFirst("#EXT-X-STREAM-INF:") >= 0) {
+        mediaURL = ChooseVariant(playlist, m_url);
+        if (mediaURL.IsEmpty() || !FetchText(mediaURL, playlist)) {
+            m_running = false;
+            return;
+        }
+    }
+
+    long long lastSequence = -1;
+    BString initURL;
+    bool first = true;
+    off_t flushedAt = 0;
+
+    while (!m_quit) {
+        long long sequence = 0;
+        double targetDuration = 5;
+        bool endList = false;
+        BString map;
+
+        struct Entry { long long sequence; BString url; };
+        std::vector<Entry> entries;
+
+        BString line;
+        int32 position = 0;
+        bool haveInfo = false;
+        while (position < playlist.Length()) {
+            int32 end = playlist.FindFirst('\n', position);
+            if (end < 0)
+                end = playlist.Length();
+            playlist.CopyInto(line, position, end - position);
+            line.RemoveAll("\r");
+            position = end + 1;
+
+            if (line.StartsWith("#EXT-X-MEDIA-SEQUENCE:"))
+                sequence = atoll(line.String() + 22);
+            else if (line.StartsWith("#EXT-X-TARGETDURATION:"))
+                targetDuration = atof(line.String() + 22);
+            else if (line.StartsWith("#EXT-X-ENDLIST"))
+                endList = true;
+            else if (line.StartsWith("#EXT-X-MAP:"))
+                map = resolve(mediaURL, attribute(line, "URI"));
+            else if (line.StartsWith("#EXTINF:"))
+                haveInfo = true;
+            else if (!line.IsEmpty() && line[0] != '#' && haveInfo) {
+                entries.push_back(Entry { sequence++, resolve(mediaURL, line) });
+                haveInfo = false;
+            }
+        }
+
+        m_live = !endList;
+
+        if (first) {
+            HLS_LOG("%s playlist, %d segments, target %.1f s\n",
+                endList ? "VOD" : "live", (int)entries.size(), targetDuration);
+            // Start a live stream three segments from its edge, as players do.
+            if (!endList && entries.size() > 3)
+                lastSequence = entries[entries.size() - 4].sequence;
+            first = false;
+        }
+
+        if (!map.IsEmpty() && map != initURL) {
+            initURL = map;
+            FetchSegment(initURL);
+        }
+
+        for (size_t i = 0; i < entries.size() && !m_quit; i++) {
+            const Entry& entry = entries[i];
+            if (entry.sequence <= lastSequence)
+                continue;
+            FetchSegment(entry.url);
+            lastSequence = entry.sequence;
+
+            off_t reader = Position();
+            if (reader - flushedAt > kFlushEvery && reader > kKeepBehind) {
+                FlushBefore(reader - kKeepBehind);
+                flushedAt = reader;
+            }
+        }
+
+        if (endList || m_quit)
+            break;
+
+        // Ask again after half a target duration, in steps short enough for
+        // the destructor not to wait on a sleeping thread.
+        bigtime_t wake = system_time() + (bigtime_t)(targetDuration * 500000);
+        while (!m_quit && system_time() < wake)
+            snooze(100000);
+        if (!m_quit && !FetchText(mediaURL, playlist))
+            snooze(1000000);
+    }
+}
+
+} // namespace WebCore
+
+#endif
