+void MediaPlayerPrivateHaikuMSE::getSupportedTypes(HashSet<String>& types)
+{
+    types.add("video/mp4"_s);
+    types.add("audio/mp4"_s);
+}
+
+// fMP4 with H.264 and AAC, which is what the hardware here plays. WebM (VP9,
+// Opus) is refused so that sites send MP4: VP9 in software is too slow on
+// this machine, and an honest "no" is what makes YouTube pick H.264.
+MediaPlayer::SupportsType MediaPlayerPrivateHaikuMSE::supportsType(const MediaEngineSupportParameters& parameters)
+{
+    MediaPlayer::SupportsType result = MediaPlayer::SupportsType::IsNotSupported;
+    if (parameters.isMediaSource) {
+        String container = parameters.type.containerType().convertToASCIILowercase();
+        if (SourceBufferPrivateHaiku::supportsContainer(container)) {
+            auto codecs = parameters.type.codecs();
+            if (codecs.isEmpty())
+                result = MediaPlayer::SupportsType::MayBeSupported;
+            else {
+                result = MediaPlayer::SupportsType::IsSupported;
+                for (auto& codec : codecs) {
+                    String c = codec.convertToASCIILowercase();
+                    bool video = c.startsWith("avc1"_s) || c.startsWith("avc3"_s);
+                    bool audio = c == "mp4a.40.2"_s || c == "mp4a.40.5"_s || c == "mp4a.40.29"_s || c == "mp4a.40"_s;
+                    if (!video && !audio)
+                        result = MediaPlayer::SupportsType::IsNotSupported;
+                    if (video && container == "audio/mp4"_s)
+                        result = MediaPlayer::SupportsType::IsNotSupported;
+                }
+            }
+        }
+    }
+    MSE_LOG("isTypeSupported %s -> %s\n", parameters.isMediaSource ? parameters.type.raw().utf8().data() : "(not MSE)",
+        result == MediaPlayer::SupportsType::IsSupported ? "probably"
+        : result == MediaPlayer::SupportsType::MayBeSupported ? "maybe" : "no");
+    return result;
+}
