+
+    status_t initialize()
+    {
+        const HaikuTrackConfig& config = m_config.get();
+        bool video = config.kind == HaikuTrackConfig::Kind::Video;
+
+        media_format_description description;
+        description.family = B_MISC_FORMAT_FAMILY;
+        description.u.misc.file_format = 'ffmp';
+        description.u.misc.codec = video ? kCodecH264 : kCodecAAC;
+
+        media_format format;
+        BMediaFormats formats;
+        if (formats.GetFormatFor(description, &format) != B_OK) {
+            format.Clear();
+            format.type = video ? B_MEDIA_ENCODED_VIDEO : B_MEDIA_ENCODED_AUDIO;
+            if (video)
+                format.u.encoded_video = media_encoded_video_format::wildcard;
+            else
+                format.u.encoded_audio = media_encoded_audio_format::wildcard;
+            status_t status = formats.MakeFormatFor(&description, 1, &format);
+            if (status != B_OK && status != B_MEDIA_DUPLICATE_FORMAT)
+                return status;
+        }
+
+        if (video) {
+            format.u.encoded_video.output.display.line_width = config.width;
+            format.u.encoded_video.output.display.line_count = config.height;
+            format.u.encoded_video.output.field_rate = 30;
+        } else {
+            format.u.encoded_audio.output.frame_rate = config.sampleRate;
+            format.u.encoded_audio.output.channel_count = config.channels;
+            format.u.encoded_audio.output.format = media_raw_audio_format::B_AUDIO_FLOAT;
+            format.u.encoded_audio.output.byte_order = B_MEDIA_HOST_ENDIAN;
+            format.u.encoded_audio.frame_size = 1024;
+        }
+
+        status_t status = SetTo(&format, config.codecPrivate.data(), config.codecPrivate.size());
+        if (status != B_OK)
+            return status;
+
+        m_output.Clear();
+        if (video) {
+            m_output.type = B_MEDIA_RAW_VIDEO;
+            m_output.u.raw_video = media_raw_video_format::wildcard;
+            m_output.u.raw_video.display.format = B_RGB32;
+            m_output.u.raw_video.display.line_width = config.width;
+            m_output.u.raw_video.display.line_count = config.height;
+            m_output.u.raw_video.display.bytes_per_row = config.width * 4;
+        } else {
+            m_output.type = B_MEDIA_RAW_AUDIO;
+            m_output.u.raw_audio = media_raw_audio_format::wildcard;
+            m_output.u.raw_audio.format = media_raw_audio_format::B_AUDIO_FLOAT;
+            m_output.u.raw_audio.byte_order = B_MEDIA_HOST_ENDIAN;
+        }
+        status = SetOutputFormat(&m_output);
+        if (status != B_OK)
+            return status;
+
+        media_codec_info info;
+        if (GetDecoderInfo(&info) == B_OK)
+            MSE_LOG("%s decoder: %s\n", video ? "video" : "audio", info.pretty_name);
+        return B_OK;
+    }
+
+    const HaikuTrackConfig& config() const { return m_config.get(); }
+    const media_format& output() const { return m_output; }
+
+protected:
+    status_t GetNextChunk(const void** chunkData, size_t* chunkLength, media_header* header) final
+    {
+        BAutolock locker(m_player.m_lock);
+        auto* track = m_player.trackFor(m_trackID);
+        if (!track || track->queue.isEmpty())
+            return B_LAST_BUFFER_ERROR;
+        m_current = track->queue.takeFirst();
+        m_player.requestMoreSamplesIfNeeded(*track);
+
+        memset(header, 0, sizeof(*header));
+        header->type = m_config->kind == HaikuTrackConfig::Kind::Video ? B_MEDIA_ENCODED_VIDEO : B_MEDIA_ENCODED_AUDIO;
+        header->start_time = bigtime_t(m_current->presentationTime().toDouble() * 1000000);
+        header->size_used = m_current->data().size();
+        *chunkData = m_current->data().data();
+        *chunkLength = m_current->data().size();
+        return B_OK;
+    }
+
+private:
+    MediaPlayerPrivateHaikuMSE& m_player;
+    TrackID m_trackID;
+    Ref<HaikuTrackConfig> m_config;
+    RefPtr<HaikuMediaSample> m_current;
+    media_format m_output;
+};
