+Ref<MediaPromise> SourceBufferPrivateHaiku::appendInternal(Ref<SharedBuffer>&& data)
+{
+    m_input.appendVector(data->extractData());
+    MSE_LOG("append: %zu bytes buffered\n", m_input.size());
+    if (!parseBoxes()) {
+        MSE_LOG("parse error, dropping %zu bytes\n", m_input.size());
+        m_input.clear();
+        return MediaPromise::createAndReject(PlatformMediaError::ParsingError);
+    }
+    return MediaPromise::createAndResolve();
