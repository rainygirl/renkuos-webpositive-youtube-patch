+namespace WebCore {
+
+class MediaSourcePrivateHaiku;
+
+// A SourceBuffer for fragmented MP4, the format YouTube and most other MSE
+// sites send for H.264 and AAC. Appended bytes are parsed here into an
+// initialization segment and coded frames; WebCore's SourceBufferPrivate
+// does the buffering, the timestamp bookkeeping and the seek arithmetic, and
+// hands frames back through enqueueSample() for the player to decode.
+class SourceBufferPrivateHaiku final : public SourceBufferPrivate {
+public:
+    static Ref<SourceBufferPrivateHaiku> create(MediaSourcePrivateHaiku&, uint32_t index);
+    ~SourceBufferPrivateHaiku();
+
+    constexpr MediaPlatformType platformType() const final { return MediaPlatformType::Haiku; }
+
+    static bool supportsContainer(const String& lowercasedContainerType);
+
+    // Called by the player, on the main thread, when a track's queue has room.
+    void readyForMoreSamples(TrackID);
+    void reenqueueMediaIfNeeded(const MediaTime& currentTime) final;
+
+private:
+    SourceBufferPrivateHaiku(MediaSourcePrivateHaiku&, uint32_t index);
+
+    Ref<MediaPromise> appendInternal(Ref<SharedBuffer>&&) final;
+    void resetParserStateInternal() final;
+    bool canSwitchToType(const ContentType&) final;
+
+    void flush(TrackID) final;
+    void enqueueSample(Ref<MediaSample>&&, TrackID) final;
+    bool isReadyForMoreSamples(TrackID) final;
+    void notifyClientWhenReadyForMoreSamples(TrackID) final;
+
+#if !RELEASE_LOG_DISABLED
+    const Logger& sourceBufferLogger() const final;
+    uint64_t sourceBufferLogIdentifier() final { return 0; }
+    const Logger& logger() const final { return sourceBufferLogger(); }
+    ASCIILiteral logClassName() const final { return "SourceBufferPrivateHaiku"_s; }
+    uint64_t logIdentifier() const final { return 0; }
+    WTFLogChannel& logChannel() const final;
+#endif
+
+    // fMP4 parsing
+    bool parseBoxes();
+    bool parseMovie(const uint8_t*, size_t);
+    bool parseTrack(const uint8_t*, size_t, uint32_t& trackID, Ref<HaikuTrackConfig>&);
+    bool parseFragment(const uint8_t* moof, size_t moofSize, const uint8_t* mdat, size_t mdatSize, size_t mdatOffsetFromMoof);
+
+    TrackID trackIDFor(uint32_t mp4TrackID) const { return (TrackID(m_index) << 32) | mp4TrackID; }
+
+    RefPtr<MediaSourcePrivateHaiku> mediaSourcePrivate() const;
+
+    struct TrackDefaults {
+        uint32_t duration { 0 };
+        uint32_t size { 0 };
+        uint32_t flags { 0 };
+    };
+
+    uint32_t m_index;
+    uint64_t m_enqueued { 0 };
+    Vector<uint8_t> m_input;
+    HashMap<uint32_t, Ref<HaikuTrackConfig>, IntHash<uint32_t>, WTF::UnsignedWithZeroKeyHashTraits<uint32_t>> m_tracks;
+    HashMap<uint32_t, TrackDefaults, IntHash<uint32_t>, WTF::UnsignedWithZeroKeyHashTraits<uint32_t>> m_trackDefaults;
+};
+
+} // namespace WebCore
+
+SPECIALIZE_TYPE_TRAITS_BEGIN(WebCore::SourceBufferPrivateHaiku)
+static bool isType(const WebCore::SourceBufferPrivate& sourceBuffer) { return sourceBuffer.platformType() == WebCore::MediaPlatformType::Haiku; }
+SPECIALIZE_TYPE_TRAITS_END()
+
+#endif
