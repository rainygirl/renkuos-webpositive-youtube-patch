+#pragma once
+
+#if ENABLE(VIDEO)
+
+#include <AdapterIO.h>
+#include <OS.h>
+#include <String.h>
+
+namespace WebCore {
+
+// HTTP Live Streaming for the Haiku media engine. The Media Kit has no HLS
+// reader, so this does what Safari's AVFoundation does underneath: read the
+// playlist, pick a variant, and fetch its segments one after another. The
+// segments (MPEG-TS, or fMP4 after an EXT-X-MAP) are concatenated into one
+// stream the Media Kit's ffmpeg reader demuxes like any other file. A live
+// playlist is fetched again every half target duration for new segments.
+class HLSMediaIO final : public BAdapterIO {
+public:
+    explicit HLSMediaIO(const char* url, const char* userAgent);
+    ~HLSMediaIO();
+
+    status_t Open() override;
+    bool IsRunning() const override;
+
+    bool IsLive() const { return m_live; }
+
+    static bool IsHLSURL(const char* url);
+
+protected:
+    status_t SeekRequested(off_t position) override;
+
+private:
+    static status_t FetchThread(void*);
+    void Fetch();
+    void FetchStream();
+    bool FetchText(const BString& url, BString& out);
+    bool FetchSegment(const BString& url);
+    BString ChooseVariant(const BString& master, const BString& masterURL);
+
+    // One handle each for playlists and segments, kept for the whole stream:
+    // a handle keeps its connection, and a fresh TLS handshake for every
+    // five-second segment was a tenth of the Atom.
+    void* m_playlistCurl { nullptr };
+    void* m_segmentCurl { nullptr };
+
+    BString m_url;
+    BString m_userAgent;
+    BInputAdapter* m_input { nullptr };
+    thread_id m_thread { -1 };
+    volatile bool m_quit { false };
+    volatile bool m_running { false };
+    volatile bool m_live { false };
+    off_t m_written { 0 };
+};
+
+} // namespace WebCore
+
+#endif
