+
+Ref<MediaSourcePrivateHaiku> MediaSourcePrivateHaiku::create(MediaPlayerPrivateHaikuMSE& player, MediaSourcePrivateClient& client)
+{
+    auto source = adoptRef(*new MediaSourcePrivateHaiku(player, client));
+    client.setPrivateAndOpen(source.copyRef());
+    return source;
+}
+
+MediaSourcePrivateHaiku::MediaSourcePrivateHaiku(MediaPlayerPrivateHaikuMSE& player, MediaSourcePrivateClient& client)
+    : MediaSourcePrivate(client)
+    , m_player(player)
+{
+}
+
+MediaSourcePrivateHaiku::~MediaSourcePrivateHaiku() = default;
+
+RefPtr<MediaPlayerPrivateInterface> MediaSourcePrivateHaiku::player() const
+{
+    return m_player.get();
+}
+
+RefPtr<MediaPlayerPrivateHaikuMSE> MediaSourcePrivateHaiku::haikuPlayer() const
+{
+    return m_player.get();
+}
+
+void MediaSourcePrivateHaiku::setPlayer(MediaPlayerPrivateInterface* player)
+{
+    m_player = downcast<MediaPlayerPrivateHaikuMSE>(player);
+}
+
+MediaSourcePrivate::AddStatus MediaSourcePrivateHaiku::addSourceBuffer(const ContentType& type, RefPtr<SourceBufferPrivate>& outPrivate)
+{
+    MediaEngineSupportParameters parameters;
+    parameters.isMediaSource = true;
+    parameters.type = type;
+    if (MediaPlayerPrivateHaikuMSE::supportsType(parameters) == MediaPlayer::SupportsType::IsNotSupported) {
+        MSE_LOG("addSourceBuffer %s: not supported\n", type.raw().utf8().data());
+        return AddStatus::NotSupported;
+    }
+    MSE_LOG("addSourceBuffer %s\n", type.raw().utf8().data());
+
+    m_sourceBuffers.append(SourceBufferPrivateHaiku::create(*this, m_nextSourceBufferIndex++));
+    outPrivate = m_sourceBuffers.last();
+    outPrivate->setMediaSourceDuration(duration());
+    return AddStatus::Ok;
+}
+
+void MediaSourcePrivateHaiku::durationChanged(const MediaTime& duration)
+{
+    MediaSourcePrivate::durationChanged(duration);
+    MSE_LOG("duration %.3f\n", duration.toDouble());
+    if (RefPtr player = haikuPlayer())
+        player->durationChanged();
+}
+
+void MediaSourcePrivateHaiku::markEndOfStream(EndOfStreamStatus status)
+{
+    if (RefPtr player = haikuPlayer(); player && status == EndOfStreamStatus::NoError)
+        player->setNetworkState(MediaPlayer::NetworkState::Loaded);
+    MediaSourcePrivate::markEndOfStream(status);
+}
+
+MediaPlayer::ReadyState MediaSourcePrivateHaiku::mediaPlayerReadyState() const
+{
+    if (RefPtr player = haikuPlayer())
+        return player->readyState();
+    return MediaPlayer::ReadyState::HaveNothing;
+}
+
+void MediaSourcePrivateHaiku::setMediaPlayerReadyState(MediaPlayer::ReadyState readyState)
+{
+    if (RefPtr player = haikuPlayer())
+        player->setReadyState(readyState);
+}
+
+void MediaSourcePrivateHaiku::notifyActiveSourceBuffersChanged()
+{
+    if (RefPtr player = haikuPlayer())
+        player->notifyActiveSourceBuffersChanged();
+}
+
+void MediaSourcePrivateHaiku::setTrackConfig(TrackID trackID, Ref<HaikuTrackConfig>&& config)
+{
+    if (RefPtr player = haikuPlayer())
+        player->setTrackConfig(trackID, WTFMove(config));
+}
+
+void MediaSourcePrivateHaiku::flushTrack(TrackID trackID)
+{
+    if (RefPtr player = haikuPlayer())
+        player->flushTrack(trackID);
+}
+
+void MediaSourcePrivateHaiku::enqueueSample(Ref<HaikuMediaSample>&& sample, TrackID trackID)
+{
+    if (RefPtr player = haikuPlayer())
+        player->enqueueSample(WTFMove(sample), trackID);
+}
+
+bool MediaSourcePrivateHaiku::isReadyForMoreSamples(TrackID trackID)
+{
+    RefPtr player = haikuPlayer();
+    return player && player->isReadyForMoreSamples(trackID);
+}
+
+void MediaSourcePrivateHaiku::notifyWhenReadyForMoreSamples(TrackID trackID, SourceBufferPrivateHaiku& sourceBuffer)
+{
+    if (RefPtr player = haikuPlayer())
+        player->notifyWhenReadyForMoreSamples(trackID, sourceBuffer);
+}
+
+} // namespace WebCore
